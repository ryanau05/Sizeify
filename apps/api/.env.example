# Copy to .env locally. Do not commit secrets.

# ---------------------------------------------------------------------------
# Postgres (asyncpg driver)
# ---------------------------------------------------------------------------
# Backed by the postgres:16 service in infra/docker-compose.yml. Defaults
# below match the compose file's default credentials so `docker compose up -d`
# in infra/ is the only setup step needed for local dev.
#
# To override, export the matching POSTGRES_* vars before `docker compose up`,
# or create an infra/.env file (gitignored) — and update DATABASE_URL here.
DATABASE_URL=postgresql+asyncpg://sizeify:sizeify@localhost:5432/sizeify
POSTGRES_DB=sizeify
POSTGRES_USER=sizeify
POSTGRES_PASSWORD=sizeify

# ---------------------------------------------------------------------------
# Redis (arq queue + caching)
# ---------------------------------------------------------------------------
# Backed by the redis:7 service in infra/docker-compose.yml. No auth in local
# dev; production will set a password.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Anthropic API (LLM extraction service). Must be a zero-retention key.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# JWT signing secret (long random string in prod)
# ---------------------------------------------------------------------------
JWT_SECRET=replace-me-with-a-long-random-string

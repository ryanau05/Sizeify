root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{py,toml,yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{kt,kts}]
# Allow PascalCase function names for Composable / Test / Preview functions.
ktlint_function_naming_ignore_when_annotated_with = Composable,Test,Preview
# Use the ktlint "android" code style (slightly looser than standard).
ktlint_code_style = android_studio
